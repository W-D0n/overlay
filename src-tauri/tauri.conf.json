{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overlay Studio",
  "version": "0.1.0",
  "identifier": "dev.d0n.overlay-studio",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Overlay Studio",
        "url": "index.html",
        "width": 520,
        "height": 440,
        "resizable": true
      },
      {
        "label": "studio",
        "title": "Overlay Studio — Studio",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
