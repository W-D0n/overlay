{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["*.js", "components/**/*.js", "dev/**/*.js", "dev/types/*.d.ts"],
  "exclude": ["**/*.test.js", "dev/e2e", "src-tauri", "docs", ".playwright-mcp"]
}
