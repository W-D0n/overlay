{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["*.js", "src/**/*.js", "studio/**/*.js", "server/**/*.js", "tools/**/*.js", "tools/types/*.d.ts"],
  "exclude": ["**/*.test.js", "e2e", "tools/complexity.cjs", "src-tauri", "docs", ".playwright-mcp"]
}
